<AnchorPane prefHeight="581.0" prefWidth="730.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.User4InstallationController">
   <children>
      <Label layoutX="112.0" layoutY="38.0" prefHeight="61.0" prefWidth="404.0" text="Schedule Installation Appointment">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox layoutX="112.0" layoutY="111.0" prefHeight="398.0" prefWidth="505.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter your customer ID :">
               <VBox.margin>
                  <Insets left="25.0" top="15.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Text>
            <TextField fx:id="customerIdField">
               <VBox.margin>
                  <Insets left="150.0" right="25.0" top="15.0" />
               </VBox.margin>
            </TextField>
            <Label alignment="TOP_LEFT" prefHeight="26.0" prefWidth="166.0" text="Choose Preferred Date :">
               <VBox.margin>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <DatePicker fx:id="appointmentDatePicker">
               <VBox.margin>
                  <Insets bottom="30.0" left="20.0" />
               </VBox.margin>
            </DatePicker>
            <Button mnemonicParsing="false" onAction="#confirmAppointmentOnAction" prefHeight="58.0" prefWidth="417.0" text="Confirm Appointment">
