<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="438.0" prefWidth="602.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.User4Finalize">
   <children>
      <Label layoutX="83.0" layoutY="40.0" prefHeight="54.0" prefWidth="436.0" text="Finalize And Submit Plan">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <VBox layoutX="75.0" layoutY="105.0" prefHeight="270.0" prefWidth="459.0">
         <children>
            <Label text="Selected Plan :">
               <VBox.margin>
                  <Insets left="20.0" top="10.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="selectedPlanField" promptText="Enter Selected Plan">
               <VBox.margin>
                  <Insets left="30.0" right="40.0" top="5.0" />
               </VBox.margin>
            </TextField>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Total Cost :">
               <VBox.margin>
                  <Insets left="20.0" top="20.0" />
               </VBox.margin>
            </Text>
            <Label fx:id="showTotalCostLabel" prefHeight="29.0" prefWidth="250.0">
               <VBox.margin>
                  <Insets bottom="30.0" left="30.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#submitRequestOnAction" prefHeight="44.0" prefWidth="216.0" text="Submit Request">
               <VBox.margin>
                  <Insets left="30.0" />
               </VBox.margin>
            </Button>
            <Label fx:id="submitStatusLabel" prefHeight="38.0" prefWidth="378.0">
               <VBox.margin>
                  <Insets left="40.0" top="10.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
