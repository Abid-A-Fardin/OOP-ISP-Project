<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.User4PlanDetails">
   <children>
      <Label layoutX="220.0" layoutY="36.0" prefHeight="38.0" prefWidth="237.0" text="Plan Details">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <ComboBox fx:id="planSelectionCB" layoutX="145.0" layoutY="85.0" prefHeight="26.0" prefWidth="286.0" promptText="Select Your Plan" />
      <VBox layoutX="95.0" layoutY="134.0" prefHeight="198.0" prefWidth="426.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Plan Name :">
               <VBox.margin>
                  <Insets left="20.0" top="10.0" />
               </VBox.margin>
            </Text>
            <Label fx:id="planNameLabel" prefHeight="18.0" prefWidth="262.0">
               <VBox.margin>
                  <Insets bottom="10.0" left="30.0" top="7.0" />
               </VBox.margin>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Speed:">
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </Text>
            <Label fx:id="planSpeedLabel" prefHeight="18.0" prefWidth="278.0">
               <VBox.margin>
                  <Insets left="25.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Router :">
               <VBox.margin>
                  <Insets left="20.0" top="10.0" />
               </VBox.margin>
            </Text>
            <Label fx:id="planRouterLabel" prefHeight="18.0" prefWidth="248.0">
               <VBox.margin>
                  <Insets left="25.0" top="10.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
      <Button layoutX="119.0" layoutY="340.0" mnemonicParsing="false" onAction="#selectPlanOnAction" prefHeight="26.0" prefWidth="178.0" text="Select Plan" />
      <Button layoutX="528.0" layoutY="361.0" mnemonicParsing="false" onAction="#backToDashboardOnAction" prefHeight="26.0" prefWidth="63.0" text="Back" />
   </children>
</AnchorPane>
