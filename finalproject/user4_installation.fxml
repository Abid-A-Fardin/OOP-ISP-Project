<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="483.0" prefWidth="627.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.User4Installation">
   <children>
      <Label layoutX="112.0" layoutY="38.0" prefHeight="61.0" prefWidth="404.0" text="Schedule Installation Appointment">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox layoutX="105.0" layoutY="100.0" prefHeight="347.0" prefWidth="416.0">
         <children>
            <Label alignment="TOP_LEFT" prefHeight="26.0" prefWidth="166.0" text="Choose Preferred Date :">
               <VBox.margin>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <DatePicker fx:id="appointmentDatePicker">
               <VBox.margin>
                  <Insets bottom="30.0" left="20.0" />
               </VBox.margin>
            </DatePicker>
            <Button mnemonicParsing="false" onAction="#confirmAppointmentOnAction" prefHeight="58.0" prefWidth="417.0" text="Confirm Appointment">
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin>
            </Button>
            <Label fx:id="appointmentConfirmationLabel" prefHeight="110.0" prefWidth="425.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
