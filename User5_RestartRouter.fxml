   <children>
      <Label layoutX="215.0" layoutY="38.0" text="Restart Router" textFill="#a81d1d">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <Button fx:id="restartRouterNowButton" layoutX="105.0" layoutY="175.0" mnemonicParsing="false" onAction="#restartRouterNowButton" prefHeight="62.0" prefWidth="373.0" text="Restart Router Now" />
      <Label fx:id="statusLabel" contentDisplay="CENTER" layoutX="116.0" layoutY="302.0" prefHeight="39.0" prefWidth="269.0" text="Router Rebooting..." />
